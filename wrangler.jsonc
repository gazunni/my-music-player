{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-music-player",
  "main": "worker.js",
  "compatibility_date": "2026-05-16",
  "vars": {
    "NEW_PULSE_COUNT": "6"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/gx9k-panel.html"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    {
      "binding": "COVERS_BUCKET",
      "bucket_name": "my-album-covers"
    },
    {
      "binding": "MUSIC_BUCKET",
      "bucket_name": "my-hits-list"
    }
  ],
  "d1_databases": [
    {
      "binding": "STATS_DB",
      "database_name": "generify-music-stats",
      "database_id": "c99d9d69-f691-4e9a-bace-527b06e45df9"
    }
  ]
}
